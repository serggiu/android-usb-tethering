#!/usr/bin/env bash
#
# samsung-tethering — one-shot installer for Android USB tethering on macOS.
#
# What it does:
#   1. checks macOS + Homebrew prerequisites
#   2. installs TetherKit (a kext-free, user-space RNDIS driver) via Homebrew
#   3. verifies the phone is detected as an RNDIS device
#
# Nothing is disabled: SIP stays on, no kernel extensions, no security policy
# changes. Works on Apple Silicon (M1-M4) and Intel, macOS 13.3+.
#
# Usage:
#   ./bin/setup                # interactive install
#   ./bin/setup --check        # only verify prerequisites + device, no install
#
# After this completes, start tethering with:  ./bin/tether start

set -euo pipefail

log() { printf '\033[1;34m[setup]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }
ok() { printf '\033[1;32m[ok]\033[0m %s\n' "$*"; }

CHECK_ONLY=0
[[ "${1:-}" == "--check" ]] && CHECK_ONLY=1

# --- prerequisites -----------------------------------------------------------

[[ "$(uname)" == "Darwin" ]] || die "This is a macOS-only setup."
macos_version="$(sw_vers -productVersion)"
log "macOS $macos_version"
log "Architecture: $(uname -m)"

if ! command -v brew >/dev/null 2>&1; then
    die "Homebrew is not installed. Install it first, then re-run this script:

    /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"
"
fi
BREW="$(command -v brew)"
ok "Homebrew found: $BREW"

# --- install TetherKit CLI ---------------------------------------------------

install_tetherkit() {
    log "Installing TetherKit (user-space RNDIS driver) from XiaoMiku01's tap..."
    "$BREW" tap XiaoMiku01/tap
    "$BREW" install XiaoMiku01/tap/tetherkit-cli
}

if command -v tetherkit-cli >/dev/null 2>&1; then
    ok "tetherkit-cli already installed: $(command -v tetherkit-cli)"
elif [[ "$CHECK_ONLY" -eq 1 ]]; then
    die "'$BREW install XiaoMiku01/tap/tetherkit-cli' is required (--check mode)."
else
    install_tetherkit
    ok "tetherkit-cli installed: $(command -v tetherkit-cli)"
fi

# --- verify the phone --------------------------------------------------------

log "Scanning for your phone (USB tethering must be ON on the phone)..."
if ! tetherkit-cli --list 2>&1; then
    warn "No RNDIS device found. That is fine for installing; before you can use it:"
    warn "  - plug the phone in with a data-capable USB-C cable"
    warn "  - on the phone: Settings -> Connections -> Mobile hotspot and tethering"
    warn "    -> turn ON 'USB tethering'"
    warn "  - confirm any 'Use USB for ...' dialog that pops up on the phone"
    warn "Then run:   ./bin/tether start  (or re-run ./bin/setup --check)"
else
    ok "Phone detected as an RNDIS device. Next step:"
    ok "    ./bin/tether start"
fi